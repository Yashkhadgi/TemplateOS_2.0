# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Backend
APP_NAME=TemplateOS API
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:5173

# Set these locally. Never commit real database URLs or secrets.
DATABASE_URL=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Local file storage
STORAGE_BASE_PATH=backend/storage

# Optional AI support. Leave blank to disable AI features.
AWS_REGION=
BEDROCK_MODEL_SUGGESTIONS=
AI_MAX_OUTPUT_TOKENS=1024

# AWS credentials are intentionally omitted. Use the standard AWS credential
# chain, a local profile, or uncommitted environment variables.

# Optional local demo accounts. Supply values only in an uncommitted .env.
SIT_SUPER_ADMIN_EMAIL=
SIT_SUPER_ADMIN_PASSWORD=
SIT_ORG_ADMIN_EMAIL=
SIT_ORG_ADMIN_PASSWORD=
SIT_DEPARTMENT_ADMIN_EMAIL=
SIT_DEPARTMENT_ADMIN_PASSWORD=
SIT_FACULTY_EMAIL=
SIT_FACULTY_PASSWORD=
SIT_STUDENT_EMAIL=
SIT_STUDENT_PASSWORD=
SIT_APPROVER_EMAIL=
SIT_APPROVER_PASSWORD=
SIT_NORMAL_USER_EMAIL=
SIT_NORMAL_USER_PASSWORD=
